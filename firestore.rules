rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true; }
    function admin() { return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function published(id) { return exists(/databases/$(database)/documents/events/$(id)) && get(/databases/$(database)/documents/events/$(id)).data.publicationStatus == 'published' && get(/databases/$(database)/documents/events/$(id)).data.deletedAt == null; }
    match /users/{uid} { allow read: if active() && (request.auth.uid == uid || admin()); allow write: if false; }
    match /events/{id} { allow read: if active() && (admin() || (resource.data.publicationStatus == 'published' && resource.data.deletedAt == null)); allow write: if false; }
    match /eventResponses/{id} {
      allow read: if active() && (admin() || resource.data.userId == request.auth.uid);
      function valid() { let d = request.resource.data; return active() && d.keys().hasOnly(['eventId', 'userId', 'status', 'createdAt', 'updatedAt']) && d.eventId is string && d.userId == request.auth.uid && id == d.eventId + '_' + request.auth.uid && d.status in ['attending', 'maybe', 'declined'] && d.createdAt is timestamp && d.updatedAt == request.time && published(d.eventId); }
      allow create: if valid() && request.resource.data.createdAt == request.time;
      allow update: if valid() && resource.data.userId == request.auth.uid && request.resource.data.eventId == resource.data.eventId && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    // All administrative writes go through the authenticated server so audit/version
    // invariants cannot be bypassed by a direct client SDK write, even by an admin.
    match /eventChangeLogs/{id} { allow read: if admin(); allow write: if false; }
    match /notificationLogs/{id} { allow read: if admin(); allow write: if false; match /recipients/{uid} { allow read: if admin(); allow write: if false; } }
    match /{document=**} { allow read, write: if false; }
  }
}
