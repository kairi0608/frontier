{
  "name": "frontier-events",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/test-browser.mjs prototype",
    "test:e2e:production": "node scripts/test-browser.mjs production",
    "test:rules": "firebase emulators:exec --only firestore --project demo-frontier \"vitest run\"",
    "admin:init": "tsx --env-file=.env.local scripts/init-admin.ts"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "13.6.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "15.30.1",
    "happy-dom": "20.14.5",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
